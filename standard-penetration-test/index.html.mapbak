</head><body><header><div class="container"><div class="header-top"><div><div style="display:inline-flex;flex-direction:column;gap:2px;"><span style="font-family:Georgia, "Times New Roman", serif;sans-serif;font-weight:800;color:#fafafa;letter-spacing:-0.02em;line-height:1;font-size:24px;">Annecy Fr</span><div style="height:3px;width:60%;background:#171717;border-radius:2px;"></div></div><div style="color:rgba(255,255,255,0.65);font-size:.8rem;margin-top:.4rem">Annecy, France</div></div><div class="header-contact"><a href="mailto:contact@geotechnique.sbs">contact@geotechnique.sbs</a></div></div><nav aria-label="breadcrumb" style="padding:.3rem 0;font-size:.78rem;color:rgba(255,255,255,0.75)"><ol style="list-style:none;display:flex;gap:.35rem;flex-wrap:wrap;padding:0;margin:0"><li><a href="/" style="color:inherit;text-decoration:none">Accueil</a></li><li>›</li><li>Exploration</li><li>›</li><li aria-current="page" style="color:rgba(255,255,255,0.95)">Essai SPT (Standard Penetration Test) à Annecy</li></ol></nav><h1>Essai SPT (Standard Penetration Test) à Annecy</h1></div></header><div class="container"><div class="content-area"><aside class="sidebar"><nav><a href="index.html" class="home">Accueil</a><div class="cat-item" data-cat="exploration"><div class="cat-row"><a href="../exploration/" class="cat-name">Exploration</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Exploration"><span class="cat-arrow">▼</span></button></div><div class="cat-sub-wrap" hidden><a href="../cone-penetration-test">Essai CPT (Cone Penetration Test)</a><a href="../standard-penetration-test">Essai SPT (Standard Penetration Test)</a><a href="../puits-dexploration">Fouille d'essai (Puits d'exploration)</a></div></div><div class="cat-item" data-cat="essais-in-situ"><div class="cat-row"><a href="../essais-in-situ/" class="cat-name">Essais in situ</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Essais in situ"><span class="cat-arrow">▼</span></button></div><div class="cat-sub-wrap" hidden><a href="/">Essai au dilatomètre plat (DMT)</a><a href="/">Essai d'infiltration (Porchet/Double anneau)</a><a href="/">Essai de cisaillement au scissomètre de chantier (Vane Shear Test)</a><a href="/">Essai de densité sur site (méthode du cône de sable)</a><a href="/">Essai de perméabilité sur site (Lefranc/Lugeon)</a><a href="../plaque-charge">Essai de plaque de charge (PLT)</a><a href="/">Essai pressiométrique Ménard</a><a href="/">Échantillonnage non remanié (tube Shelby)</a></div></div><div class="cat-item" data-cat="laboratoire"><div class="cat-row"><a href="../laboratoire/" class="cat-name">Laboratoire</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Laboratoire"><span class="cat-arrow">▼</span></button></div><div class="cat-sub-wrap" hidden><a href="../analyse-granulometrique">Analyse granulométrique (tamisage + hydromètre)</a><a href="../caracterisation-sols-residuels">Caractérisation des sols résiduels</a><a href="../classification-sols">Classification des sols (USCS/AASHTO)</a><a href="../cbr-laboratoire">Essai CBR en laboratoire</a><a href="../cisaillement-direct">Essai de cisaillement direct</a><a href="../compression-simple">Essai de compression simple (UCS)</a><a href="../consolidation-œdometrique">Essai de consolidation œdométrique</a><a href="../permeabilite-laboratoire">Essai de perméabilité en laboratoire (charge variable/constante)</a><a href="../normal-modifie">Essai Proctor (Normal ou Modifié)</a><a href="/">Essai triaxial</a><a href="/">Limites d'Atterberg</a><a href="../etude-mecanique-sols">Étude de mécanique des sols</a></div></div><div class="cat-item" data-cat="fondations"><div class="cat-row"><a href="../fondations/" class="cat-name">Fondations</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Fondations"><span class="cat-arrow">▼</span></button></div><div class="cat-sub-wrap" hidden><a href="/">Analyse de capacité portante</a><a href="../analyse-tassement-differentiel">Analyse de tassement différentiel</a><a href="/">Analyse de tassements</a><a href="../analyse-pieux-frottement-lateral">Analyse pieux: frottement latéral vs. pointe</a><a href="/">Conception de fondations parasismiques</a><a href="../conception-fondations-superficielles">Conception de fondations superficielles</a><a href="/">Conception de fondations sur pieux</a><a href="/">Conception de micropieux</a><a href="../conception-pieux-battus">Conception de pieux battus</a><a href="../conception-radier-general">Conception de radier général</a><a href="/">Fondations sur remblais (analyse)</a><a href="/">Évaluation des sols affaissables</a><a href="/">Évaluation des sols gonflants</a></div></div><div class="cat-item" data-cat="pentes-et-murs"><div class="cat-row"><a href="../pentes-et-murs/" class="cat-name">Pentes et murs</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Pentes et murs"><span class="cat-arrow">▼</span></button></div><div class="cat-sub-wrap" hidden><a href="/">Analyse de l'érosion des sols</a><a href="/">Analyse de rupture de pente</a><a href="../analyse-stabilite-pentes">Analyse de stabilité des pentes</a><a href="/">Analyse des coulées de débris</a><a href="../calcul-coefficient-securite">Calcul du coefficient de sécurité (FS)</a><a href="/">Conception avec géocellules</a><a href="/">Conception d'ancrages actifs/passifs</a><a href="../conception-murs-soutenement">Conception de murs de soutènement</a><a href="../conception-murs-terre-armee">Conception de murs en Terre Armée Mécaniquement (MSE)</a><a href="../conception-parois-moulees">Conception de parois moulées</a><a href="../conception-rideaux-palplanches">Conception de rideaux de palplanches</a><a href="/">Conception de stabilisation des pentes</a><a href="/">Surveillance géotechnique des pentes (mensuelle)</a><a href="/">Évaluation des glissements de terrain</a></div></div><div class="cat-item" data-cat="amelioration"><div class="cat-row"><a href="../amelioration/" class="cat-name">Amélioration</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Amélioration"><span class="cat-arrow">▼</span></button></div><div class="cat-sub-wrap" hidden><a href="/">Analyse des sols non saturés</a><a href="/">Conception d'injections (grouting)</a><a href="/">Conception de colonnes ballastées (stone columns)</a><a href="../conception-compactage-dynamique">Conception de compactage dynamique</a><a href="/">Conception de Deep Soil Mixing (DSM)</a><a href="../conception-drainage-geotechnique">Conception de drainage géotechnique</a><a href="/">Conception de drains verticaux préfabriqués</a><a href="/">Conception de jet grouting</a><a href="/">Conception de préchargement (sans surcharge)</a><a href="/">Conception de préchargement avec surcharge</a><a href="../conception-vibrocompactage">Conception de vibrocompactage</a><a href="/">Gestion des sols organiques</a><a href="/">Géotechnique des centres d'enfouissement</a><a href="/">Instrumentation géotechnique (conception et installation)</a><a href="../remediation-sols-contamines">Remédiation des sols contaminés</a><a href="../specification-geogrilles">Spécification des géogrilles</a><a href="/">Spécification des géomembranes</a><a href="/">Spécification des géotextiles</a><a href="/">Stabilisation à la chaux et au ciment</a></div></div><div class="cat-item" data-cat="sismique"><div class="cat-row"><a href="../sismique/" class="cat-name">Sismique</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Sismique"><span class="cat-arrow">▼</span></button></div><div class="cat-sub-wrap" hidden><a href="/">Analyse d'amplification sismique</a><a href="../analyse-liquefaction-sols">Analyse de liquéfaction des sols</a><a href="../analyse-reponse-site">Analyse de réponse de site</a><a href="/">Conception d'isolation sismique à la base</a><a href="../microzonage-sismique">Microzonage sismique</a></div></div><div class="cat-item" data-cat="geotechnique-routiere"><div class="cat-row"><a href="../geotechnique-routiere/" class="cat-name">Routier</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Routier"><span class="cat-arrow">▼</span></button></div><div class="cat-sub-wrap" hidden><a href="../conception-chaussees-rigides">Conception de chaussées rigides</a><a href="../conception-chaussees-souples">Conception de chaussées souples</a><a href="../conception-plate-forme-routiere">Conception de plate-forme routière</a><a href="/">Conception de remblais routiers</a><a href="../drainage-routier-geotechnique">Drainage routier géotechnique</a><a href="/">Routier (conception chaussée/plate-forme)</a><a href="/">Stabilisation des sols pour routes</a><a href="/">Étude CBR pour conception routière</a><a href="/">Évaluation des chaussées existantes</a></div></div><div class="cat-item" data-cat="geophysique"><div class="cat-row"><a href="../" class="cat-name">Géophysique</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Géophysique"><span class="cat-arrow">▼</span></button></div><div class="cat-sub-wrap" hidden><a href="/">Géoradar GPR (Ground Penetrating Radar)</a><a href="/">MASW / VS30 (vitesse des ondes de cisaillement)</a><a href="/">Microtremblements HVSR (Méthode Nakamura)</a><a href="/">Résistivité électrique / SEV (Sondage Électrique Vertical)</a><a href="/">Tomographie sismique (réfraction/réflexion)</a></div></div><div class="cat-item" data-cat="excavations-souterraines"><div class="cat-row"><a href="../excavations-souterraines/" class="cat-name">Excavations</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Excavations"><span class="cat-arrow">▼</span></button></div><div class="cat-sub-wrap" hidden><a href="/">Analyse géotechnique pour tunnels en sols mous</a><a href="../conception-geotechnique-excavations-profondes">Conception géotechnique des excavations profondes</a><a href="/">Surveillance géotechnique des excavations</a></div></div></nav></aside><main><section><p>Trop de chantiers à Annecy sous-estiment la couche de limons argileux déposés par le lac. Les valeurs N-SPT y chutent brutalement sous les 8 coups. Une fondation superficielle dimensionnée sans cet essai SPT risque un tassement différentiel de plusieurs centimètres. Notre équipe réalise le test avec un train de tiges de 50 mm de diamètre et un mouton de 63,5 kg. On descend par passes de 45 cm en mesurant la résistance tous les 15 cm. Pour les zones de remblai hétérogène, on couple l'essai SPT avec le presiomètre Ménard afin d'obtenir le module de réaction latéral.</p><figure style="margin:1.5rem auto;max-width:720px;text-align:center"><img src="/img/sondaje-spt-5.webp" loading="eager" decoding="async" width="800" height="600" alt="Image illustrative de Essai SPT (Standard Penetration Test) à Annecy" style="width:100%;height:auto;display:block;border-radius:8px;border:1px solid #E5E7EB" fetchpriority="high"></figure></section><blockquote style="border-left:4px solid #171717;background:rgba(0,0,0,.03);padding:1rem 1.25rem;margin:1.5rem 0 1.5rem 1rem;font-style:italic;color:#333;font-size:1.05rem;line-height:1.55;border-radius:0 6px 6px 0">Sous les alluvions d'Annecy, un N-SPT inférieur à 10 indique un risque de liquéfaction en zone sismique modérée.</blockquote><section><h2>Caractéristiques du service à Annecy</h2><div>Le matériel employé à Annecy est un pénétromètre de conception robuste monté sur trépied. Le mouton de 63,5 kg tombe de 76 cm pour enfoncer le carottier de 35 mm. Chaque coup compte : on relève le nombre N pour les trois derniers 15 cm. L'essai SPT fournit en continu un échantillon remanié dans le carottier fendu. On le décrit visuellement, on mesure son humidité, puis on l'emballe pour les essais en labo. Avant d'interpréter les valeurs brutes, on applique les corrections de surcharge (CN) et d'énergie (CE). Les valeurs N60 sont ensuite corrélées à la capacité portante. Cette procédure suit strictement la norme NF P 94-116. Pour les sols très lâches sous les alluvions d'Annecy, un essai au pénétromètre statique CPT complète le diagnostic sans altérer l'échantillon.</div></section><figure style="margin:2rem auto;text-align:center;max-width:60%"><figcaption style="font-size:.78rem;color:#64748b;margin-top:.4rem">Essai SPT (Standard Penetration Test) à Annecy</figcaption></figure><div style="max-width:700px;margin:1.5rem auto;border-left:4px solid #171717;border-radius:6px;overflow:hidden;background:#FFF;box-shadow:0 1px 3px rgba(0,0,0,.05)"><table style="width:100%;border-collapse:collapse;font-size:.92rem"><thead><tr style="background:#171717;color:#FFF"><th style="padding:.75rem 1rem;text-align:left;font-weight:600">Paramètre</th><th style="padding:.75rem 1rem;text-align:left;font-weight:600">Valeur typique</th></tr></thead><tbody><tr style="background:#FAFAF7"><td style="padding:.7rem 1rem;border-bottom:1px solid #EEE">Masse du mouton</td><td style="padding:.7rem 1rem;border-bottom:1px solid #EEE;color:#222;font-weight:500">63,5 kg</td></tr><tr style="background:#FFFFFF"><td style="padding:.7rem 1rem;border-bottom:1px solid #EEE">Hauteur de chute</td><td style="padding:.7rem 1rem;border-bottom:1px solid #EEE;color:#222;font-weight:500">76 cm</td></tr><tr style="background:#FAFAF7"><td style="padding:.7rem 1rem;border-bottom:1px solid #EEE">Diamètre du carottier</td><td style="padding:.7rem 1rem;border-bottom:1px solid #EEE;color:#222;font-weight:500">35 mm</td></tr><tr style="background:#FFFFFF"><td style="padding:.7rem 1rem;border-bottom:1px solid #EEE">Pas de mesure</td><td style="padding:.7rem 1rem;border-bottom:1px solid #EEE;color:#222;font-weight:500">Tous les 15 cm sur 45 cm</td></tr><tr style="background:#FAFAF7"><td style="padding:.7rem 1rem;border-bottom:1px solid #EEE">Correction d'énergie</td><td style="padding:.7rem 1rem;border-bottom:1px solid #EEE;color:#222;font-weight:500">N60 (rendement 60 %)</td></tr><tr style="background:#FFFFFF"><td style="padding:.7rem 1rem;border-bottom:1px solid #EEE">Profondeur max courante</td><td style="padding:.7rem 1rem;border-bottom:1px solid #EEE;color:#222;font-weight:500">30 m</td></tr></tbody></table></div><section><h2>Conditions géotechniques locales à Annecy</h2><p>Le lac d'Annecy culmine à 446 m d'altitude. Ses rives hébergent des dépôts glacio-lacustres compressibles. En 1996, un séisme de magnitude 5,3 a secoué la région. L'essai SPT a alors montré des valeurs N-SPT de 4 à 6 dans les premiers 5 mètres. Sans ce diagnostic, une maison individuelle risquait un tassement de 8 à 12 cm sous charge. La liquéfaction des sables lâches est un danger réel. Un N-SPT corrigé inférieur à 15 dans une nappe phréatique haute impose un renforcement de sol ou des <a href="/fondations/">fondations</a> profondes. Chaque projet à Annecy exige une campagne d'essais SPT ciblée pour écarter ces risques.</p></section><section class="block mid-cta-4faa-4faa" style="padding:2rem 0"><div style="max-width:720px;margin:0 auto;background:linear-gradient(135deg,#16A34A15,#16A34A08);border-left:4px solid #16A34A;padding:1.5rem 1.8rem;border-radius:6px;text-align:center"><h3 style="margin:0 0 .4rem;font-size:1.15rem;color:#1E293B;text-align:center">Besoin d'une évaluation géotechnique ?</h3><p style="margin:0 0 1rem;color:#64748B;font-size:.92rem;text-align:center">Réponse sous 24h.</p><a href="mailto:contact@geotechnique.sbs" style="display:inline-block;background:#16A34A;color:#FFF !important;padding:1rem 2rem;border-radius:8px;text-decoration:none;font-weight:800;font-size:1.05rem;box-shadow:0 4px 12px rgba(0,0,0,.15)">E-mail: contact@geotechnique.sbs</a></div></section><div class="normas"><strong>Normes applicables:</strong> NF P 94-116 : Standard Test Method for SPT, Eurocode 7 (EN 1997-1:2004) – Annexe D, NF P94-116 : Essai de pénétration dynamique type SPT </div><section><h2>Nos services</h2><hr style="border:none;height:2px;background:linear-gradient(90deg,transparent,#A16207,transparent);margin:2rem 0;width:60%;margin-left:auto;margin-right:auto"><p>Nous déclinons l'essai SPT en quatre prestations complémentaires adaptées aux contraintes d'Annecy.</p><style>/*afx*/.servicios-grid a.servicio-link:hover h3{color:#171717}
.servicios-grid a.servicio-link{display:block;text-decoration:none;color:inherit;cursor:pointer}
.servicios-grid{display:flex;flex-wrap:wrap;gap:1rem;justify-content:flex-start}
.servicio-arrow{position:absolute;right:1rem;bottom:.8rem;color:#171717;font-weight:700;opacity:.55;transition:transform .18s,opacity .18s}
.servicios-grid a.servicio-link:hover{border-color:#171717;box-shadow:0 4px 14px rgba(0,0,0,.08);transform:translateY(-2px)}
.servicios-grid a.servicio-link:hover .servicio-arrow{transform:translateX(4px);opacity:1}
.servicios-grid .servicio{flex:0 0 calc(50% - .5rem);min-width:260px;padding:1rem 1.2rem;border:1px solid #E5E7EB;border-radius:10px;background:#FFFFFF;position:relative;transition:border-color .18s,box-shadow .18s,transform .18s}/*sbhfix*/aside .sb-home{color:#FFF !important}</style><div class="servicios-grid"><div class="servicio"><h3>Essai SPT avec carottage continu</h3><p>Réalisation de l'essai tous les 1,5 m avec prélèvement d'échantillons intacts dans le carottier fendu. Identification visuelle et conditionnement pour essais en laboratoire.</p></div><div class="servicio"><h3>SPT avec mesure des pressions interstitielles</h3><p>Installation d'un piézomètre dans le forage SPT pour suivre la dissipation de pression en terrain saturé. Interprétation des valeurs N-SPT corrigées de l'effet de nappe.</p></div><div class="servicio"><h3>SPT en forage incliné</h3><p>Exécution de l'essai sous angle (15° à 30°) pour reconnaître les couches sous des talus ou des remblais en pente. Utile pour les projets de voirie en rive du lac.</p></div><div class="servicio"><h3>SPT avec enregistrement automatique</h3><p>Capteur de coup et logiciel d'acquisition en temps réel fournissant la courbe N/m. Rapport numérique avec corrections d'énergie et interprétation géotechnique complète.</p></div></div></section><section><h2>Questions fréquentes</h2><details><summary>Quelle est la différence entre le N-SPT et la capacité portante d'un sol à Annecy ?</summary><p>Le N-SPT est le nombre de coups pour enfoncer le carottier sur 30 cm. La capacité portante se calcule à partir de N60 via des formules empiriques (Meyerhof, Terzaghi). À Annecy, un N-SPT de 12 dans les limons donne une pression admissible d'environ 150 kPa avant tassement. L'essai SPT ne fournit pas directement la portance : il faut une corrélation adaptée au type de sol.</p></details><details><summary>Combien coûte un essai SPT dans la région d'Annecy ?</summary><p>Le tarif pour un essai SPT standard à Annecy se situe entre 540 € et 760 € par point, selon la profondeur (jusqu'à 20 m) et le nombre de mesures. Le déplacement du foreur et le rapport d'interprétation sont inclus. Pour un projet de lotissement de 10 points, un forfait peut être négocié.</p></details><details><summary>Quels types de sols rencontre-t-on lors d'un essai SPT à Annecy ?</summary><p>Sous les alluvions lacustres d'Annecy, on trouve des limons argileux (couches de 2 à 8 m), des sables fins lâches (N-SPT 4-10), puis des graviers glaciaires plus denses (N-SPT 30-50). Les valeurs chutent parfois brutalement au passage de lentilles tourbeuses. L'essai SPT permet de cartographier ces hétérogénéités.</p></details></section><section><h2>Couverture à Annecy</h2><link rel="stylesheet" href="/css/leaflet-4faa.css"/><div id="mapa-ciudad"></div><script src="/js/leaflet-4faa.js"></script><script>
var map = L.map('mapa-ciudad').setView([45.8992348,6.1288847], 12);
L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}@2x.png',{attribution:'&copy; OSM &copy; CARTO',subdomains:'abcd',maxZoom:19}).addTo(map);L.marker([45.8992348,6.1288847],{icon:L.divIcon({html:'<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 36\" width=\"24\" height=\"36\"><path d=\"M12 0C5.4 0 0 5.4 0 12c0 9 12 24 12 24s12-15 12-24c0-6.6-5.4-12-12-12z\" fill=\"#E11D48\" stroke=\"#FFF\" stroke-width=\"1.5\"/><circle cx=\"12\" cy=\"12\" r=\"4\" fill=\"#FFF\"/></svg>',className:'',iconSize:[24,36],iconAnchor:[12,36]})}).addTo(map);
L.circle([45.8992348,6.1288847],{radius:3000,color:'#171717',fillColor:'#404040',fillOpacity:0.18,weight:2}).addTo(map).bindPopup('Coverage area — Annecy');
</script></section></main></div></div><link rel="stylesheet" href="/css/leaflet-4faa.css"/><script src="/js/leaflet-4faa.js"></script><script>
(function(){function init(){if(typeof L==="undefined"){setTimeout(init,200);return;}var el=document.getElementById("map-leaflet");if(!el)return;var map=L.map(el).setView([45.8992348,6.1288847],12);L.tileLayer("https://{s}.tile-4faa.openstreetmap.org/{z}/{x}/{y}.png",{attribution:"© OpenStreetMap",maxZoom:18}).addTo(map);L.marker([45.8992348,6.1288847],{icon:L.divIcon({html:'<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 36\" width=\"24\" height=\"36\"><path d=\"M12 0C5.4 0 0 5.4 0 12c0 9 12 24 12 24s12-15 12-24c0-6.6-5.4-12-12-12z\" fill=\"#E11D48\" stroke=\"#FFF\" stroke-width=\"1.5\"/><circle cx=\"12\" cy=\"12\" r=\"4\" fill=\"#FFF\"/></svg>',className:'',iconSize:[24,36],iconAnchor:[12,36],popupAnchor:[0,-32]})}).addTo(map).bindPopup("Annecy").openPopup();}if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",init);}else{init();}})();
