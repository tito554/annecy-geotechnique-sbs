</head><body><header><div class="container"><div class="header-top"><div><div style="display:inline-flex;flex-direction:column;gap:2px;"><span style="font-family:Georgia, "Times New Roman", serif;sans-serif;font-weight:800;color:#fafafa;letter-spacing:-0.02em;line-height:1;font-size:24px;">Annecy Fr</span><div style="height:3px;width:60%;background:#171717;border-radius:2px;"></div></div><div style="color:rgba(255,255,255,0.65);font-size:.8rem;margin-top:.4rem">Annecy, France</div></div><div class="header-contact"><a href="mailto:contact@geotechnique.sbs">contact@geotechnique.sbs</a></div></div><nav aria-label="breadcrumb" style="padding:.3rem 0;font-size:.78rem;color:rgba(255,255,255,0.75)"><ol style="list-style:none;display:flex;gap:.35rem;flex-wrap:wrap;padding:0;margin:0"><li><a href="/" style="color:inherit;text-decoration:none">Accueil</a></li><li>›</li><li aria-current="page" style="color:rgba(255,255,255,0.95)">Services géotechniques à Annecy</li></ol></nav><h1>Services géotechniques à Annecy</h1></div></header><div class="container"><div class="content-area"><aside class="sidebar"><nav><a href="index.html" class="home">Accueil</a><div class="cat-item" data-cat="exploration"><div class="cat-row"><a href="exploration/" class="cat-name">Exploration</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Exploration"><span class="cat-arrow">▼</span></button></div><div class="cat-sub-wrap" hidden><a href="cone-penetration-test">Essai CPT (Cone Penetration Test)</a><a href="standard-penetration-test">Essai SPT (Standard Penetration Test)</a><a href="puits-dexploration">Fouille d'essai (Puits d'exploration)</a></div></div><div class="cat-item" data-cat="essais-in-situ"><div class="cat-row"><a href="essais-in-situ/" class="cat-name">Essais in situ</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Essais in situ"><span class="cat-arrow">▼</span></button></div><div class="cat-sub-wrap" hidden><a href="plaque-charge">Essai de plaque de charge (PLT)</a></div></div><div class="cat-item" data-cat="laboratoire"><div class="cat-row"><a href="laboratoire/" class="cat-name">Laboratoire</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Laboratoire"><span class="cat-arrow">▼</span></button></div><div class="cat-sub-wrap" hidden><a href="analyse-granulometrique">Analyse granulométrique (tamisage + hydromètre)</a><a href="caracterisation-sols-residuels">Caractérisation des sols résiduels</a><a href="classification-sols">Classification des sols (USCS/AASHTO)</a><a href="cbr-laboratoire">Essai CBR en laboratoire</a><a href="cisaillement-direct">Essai de cisaillement direct</a><a href="compression-simple">Essai de compression simple (UCS)</a><a href="consolidation-œdometrique">Essai de consolidation œdométrique</a><a href="permeabilite-laboratoire">Essai de perméabilité en laboratoire (charge variable/constante)</a><a href="normal-modifie">Essai Proctor (Normal ou Modifié)</a><a href="etude-mecanique-sols">Étude de mécanique des sols</a></div></div><div class="cat-item" data-cat="fondations"><div class="cat-row"><a href="fondations/" class="cat-name">Fondations</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Fondations"><span class="cat-arrow">▼</span></button></div><div class="cat-sub-wrap" hidden><a href="analyse-tassement-differentiel">Analyse de tassement différentiel</a><a href="analyse-pieux-frottement-lateral">Analyse pieux: frottement latéral vs. pointe</a><a href="conception-fondations-superficielles">Conception de fondations superficielles</a><a href="conception-pieux-battus">Conception de pieux battus</a><a href="conception-radier-general">Conception de radier général</a></div></div><div class="cat-item" data-cat="pentes-et-murs"><div class="cat-row"><a href="pentes-et-murs/" class="cat-name">Pentes et murs</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Pentes et murs"><span class="cat-arrow">▼</span></button></div><div class="cat-sub-wrap" hidden><a href="analyse-stabilite-pentes">Analyse de stabilité des pentes</a><a href="calcul-coefficient-securite">Calcul du coefficient de sécurité (FS)</a><a href="conception-murs-soutenement">Conception de murs de soutènement</a><a href="conception-murs-terre-armee">Conception de murs en Terre Armée Mécaniquement (MSE)</a><a href="conception-parois-moulees">Conception de parois moulées</a><a href="conception-rideaux-palplanches">Conception de rideaux de palplanches</a></div></div><div class="cat-item" data-cat="amelioration"><div class="cat-row"><a href="amelioration/" class="cat-name">Amélioration</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Amélioration"><span class="cat-arrow">▼</span></button></div><div class="cat-sub-wrap" hidden><a href="conception-compactage-dynamique">Conception de compactage dynamique</a><a href="conception-drainage-geotechnique">Conception de drainage géotechnique</a><a href="conception-vibrocompactage">Conception de vibrocompactage</a><a href="remediation-sols-contamines">Remédiation des sols contaminés</a><a href="specification-geogrilles">Spécification des géogrilles</a></div></div><div class="cat-item" data-cat="sismique"><div class="cat-row"><a href="sismique/" class="cat-name">Sismique</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Sismique"><span class="cat-arrow">▼</span></button></div><div class="cat-sub-wrap" hidden><a href="analyse-liquefaction-sols">Analyse de liquéfaction des sols</a><a href="analyse-reponse-site">Analyse de réponse de site</a><a href="microzonage-sismique">Microzonage sismique</a></div></div><div class="cat-item" data-cat="geotechnique-routiere"><div class="cat-row"><a href="geotechnique-routiere/" class="cat-name">Routier</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Routier"><span class="cat-arrow">▼</span></button></div><div class="cat-sub-wrap" hidden><a href="conception-chaussees-rigides">Conception de chaussées rigides</a><a href="conception-chaussees-souples">Conception de chaussées souples</a><a href="conception-plate-forme-routiere">Conception de plate-forme routière</a><a href="drainage-routier-geotechnique">Drainage routier géotechnique</a></div></div><div class="cat-item" data-cat="excavations-souterraines"><div class="cat-row"><a href="excavations-souterraines/" class="cat-name">Excavations</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Excavations"><span class="cat-arrow">▼</span></button></div><div class="cat-sub-wrap" hidden><a href="conception-geotechnique-excavations-profondes">Conception géotechnique des excavations profondes</a></div></div></nav></aside><main><section><p>Notre bureau d'Annecy propose une gamme complète de prestations géotechniques, depuis la reconnaissance des sols jusqu'à la conception de fondations et le suivi d'exécution. Nous accompagnons les projets de construction, d'aménagement et de rénovation sur l'ensemble du bassin annécien. Notre approche intègre la spécificité des sols locaux pour garantir la sécurité et la pérennité des ouvrages, tout en respectant les normes en vigueur. Nous réalisons des <a href="analyse-stabilite-pentes/">études de sol</a> et des diagnostics approfondis pour tous types de structures.</p><figure style="margin:1.5rem auto;max-width:720px;text-align:center"><img src="img/estudio-mecanica-suelos-1.webp" loading="eager" decoding="async" width="800" height="600" alt="Image illustrative de Étude de mécanique des sols à Annecy" style="width:100%;height:auto;display:block;border-radius:8px;border:1px solid #E5E7EB" fetchpriority="high"></figure></section><figure style="margin:2rem auto;text-align:center;max-width:60%"><figcaption style="font-size:.78rem;color:#64748b;margin-top:.4rem">Services géotechniques à Annecy</figcaption></figure><section><h2>Caractéristiques du service à Annecy</h2><div>La région d'Annecy est marquée par une géologie complexe, héritée des glaciations quaternaires. Le sous-sol est principalement constitué de dépôts glaciaires et fluvio-glaciaires, incluant des moraines, des argiles lacustres et des alluvions récentes dans la vallée du Fier. On rencontre fréquemment des terrains molassiques (grès et conglomérats) du Miocène, ainsi que des formations calcaires karstiques sur les reliefs environnants. La nappe phréatique est souvent proche de la surface dans les zones basses, notamment autour du lac d'Annecy, ce qui nécessite des précautions particulières pour les excavations et les fondations. Les risques géologiques incluent des glissements de terrain sur les pentes instables et des tassements différentiels dans les sols compressibles. Une <a href="analyse-reponse-site/">analyse de la réponse sismique</a> est également requise pour les projets sensibles.</div></section><div style="margin:2rem 0"><h2>Field demonstration</h2><hr style="border:none;height:2px;background:linear-gradient(90deg,transparent,#A16207,transparent);margin:2rem 0;width:60%;margin-left:auto;margin-right:auto"><div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:10px"><iframe src="https://www.youtube-nocookie.com/embed/FVcVgAa_XLM?rel=0" style="position:absolute;top:0;left:0;width:100%;height:100%;border:none" loading="lazy" allowfullscreen title="Video"></iframe></div></div><section><h2>Conditions géotechniques locales à Annecy</h2><p>Notre équipe justifie d'une expérience régionale consolidée dans le bassin annécien, avec une connaissance fine des formations glaciaires et molassiques locales. Nous disposons d'un <a href="/laboratoire/">laboratoire</a> calibré pour réaliser des essais de cisaillement et de consolidation, et nous produisons des rapports conformes aux exigences du DTU et des assurances. Notre collaboration étroite avec les bureaux de contrôle et les collectivités locales assure une intégration fluide des études dans le processus de projet.</p></section><section class="block mid-cta-4faa-4faa" style="padding:2rem 0"><div style="max-width:720px;margin:0 auto;background:linear-gradient(135deg,#16A34A15,#16A34A08);border-left:4px solid #16A34A;padding:1.5rem 1.8rem;border-radius:6px;text-align:center"><h3 style="margin:0 0 .4rem;font-size:1.15rem;color:#1E293B;text-align:center">Besoin d'une évaluation géotechnique ?</h3><p style="margin:0 0 1rem;color:#64748B;font-size:.92rem;text-align:center">Réponse sous 24h.</p><a href="mailto:contact@geotechnique.sbs" style="display:inline-block;background:#16A34A;color:#FFF !important;padding:1rem 2rem;border-radius:8px;text-decoration:none;font-weight:800;font-size:1.05rem;box-shadow:0 4px 12px rgba(0,0,0,.15)">E-mail: contact@geotechnique.sbs</a></div></section><div class="normas"><strong>Normes applicables:</strong> Nos études sont réalisées conformément aux normes françaises et européennes, notamment la norme NF P 94-500 pour la classification des missions géotechniques, l'Eurocode 7 (NF EN 1997) pour le calcul géotechnique, et l'Eurocode 8 (NF EN 1998) pour la conception parasismique. Nous utilisons également les normes NF P 94-261 pour les fondations superficielles et NF P 94-262 pour les fondations profondes. Pour les essais en laboratoire, nous suivons les protocoles du CEN/TC 341. </div><section><h2>Nos services</h2><p></p><style>/*afx*/.servicios-grid a.servicio-link:hover h3{color:#171717}
.servicios-grid a.servicio-link{display:block;text-decoration:none;color:inherit;cursor:pointer}
.servicios-grid{display:flex;flex-wrap:wrap;gap:1rem;justify-content:flex-start}
.servicio-arrow{position:absolute;right:1rem;bottom:.8rem;color:#171717;font-weight:700;opacity:.55;transition:transform .18s,opacity .18s}
.servicios-grid a.servicio-link:hover{border-color:#171717;box-shadow:0 4px 14px rgba(0,0,0,.08);transform:translateY(-2px)}
.servicios-grid a.servicio-link:hover .servicio-arrow{transform:translateX(4px);opacity:1}
.servicios-grid .servicio{flex:0 0 calc(50% - .5rem);min-width:260px;padding:1rem 1.2rem;border:1px solid #E5E7EB;border-radius:10px;background:#FFFFFF;position:relative;transition:border-color .18s,box-shadow .18s,transform .18s}/*sbhfix*/aside .sb-home{color:#FFF !important}</style><div class="servicios-grid"><a class="servicio servicio-link" href="standard-penetration-test/"><h3>Essai SPT (Standard Penetration Test)</h3><span class="servicio-arrow" aria-hidden="true">→</span></a><a class="servicio servicio-link" href="etude-mecanique-sols/"><h3>Étude de mécanique des sols</h3><span class="servicio-arrow" aria-hidden="true">→</span></a><a class="servicio servicio-link" href="cone-penetration-test/"><h3>Essai CPT (Cone Penetration Test)</h3><span class="servicio-arrow" aria-hidden="true">→</span></a><a class="servicio servicio-link" href="conception-fondations-superficielles/"><h3>Conception de fondations superficielles</h3><span class="servicio-arrow" aria-hidden="true">→</span></a><a class="servicio servicio-link" href="conception-murs-soutenement/"><h3>Conception de murs de soutènement</h3><span class="servicio-arrow" aria-hidden="true">→</span></a><a class="servicio servicio-link" href="analyse-stabilite-pentes/"><h3>Analyse de stabilité des pentes</h3><span class="servicio-arrow" aria-hidden="true">→</span></a></div></section><section><h2>Questions fréquentes</h2><details><summary>Quels sont les risques géologiques spécifiques à Annecy ?</summary><p>Les principaux risques incluent les glissements de terrain sur les pentes des Bauges et du Semnoz, les tassements dans les argiles lacustres compressibles, et les remontées de nappe dans les zones basses près du lac. Un aléa sismique modéré (zone 3) doit également être pris en compte. Une étude géotechnique préalable permet de cartographier ces aléas et de dimensionner les ouvrages en conséquence.</p></details><details><summary>Quelle est la profondeur typique des fondations dans la région d'Annecy ?</summary><p>La profondeur varie selon la nature du sol. Dans les zones de moraine compacte, des fondations superficielles à 1-2 mètres suffisent souvent.</p></details><details><summary>Quelles normes régissent les études géotechniques en France ?</summary><p>La norme de référence est la NF P 94-500, qui définit les missions géotechniques (G1 à G5). Pour le calcul, on applique l'Eurocode 7 (NF EN 1997) et ses annexes nationales. Pour la sismicité, l'Eurocode 8 (NF EN 1998) est obligatoire. Les essais in situ et en laboratoire suivent les normes NF P 94-xxx et les standards CEN.</p></details><details><summary>Quels types de projets nécessitent une étude géotechnique à Annecy ?</summary><p>Tous les projets de construction, qu'il s'agisse de maisons individuelles, d'immeubles collectifs, de bâtiments publics, d'infrastructures routières ou d'aménagements paysagers. Les zones à risque (pentes, bords de lac, anciennes carrières) exigent une attention particulière. Même une extension légère peut nécessiter une reconnaissance si le sol est hétérogène.</p></details></section><section><h2>Couverture à Annecy</h2><div id="mapa-ciudad"></div><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"><script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script data-mapgen="1">(function(){var m=L.map("mapa-ciudad",{zoomControl:true,attributionControl:true}).setView([45.8992348,6.1288847],11);L.tileLayer("https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}@2x.png",{attribution:"&copy; Contributeurs OpenStreetMap &copy; CARTO",maxZoom:19,subdomains:"abcd"}).addTo(m);L.circle([45.8992348,6.1288847],{radius:5000,color:"#171717",weight:2,fillColor:"#404040",fillOpacity:0.18}).addTo(m).bindPopup("Annecy");})();</script></section></main></div></div><footer style="background:#0A0A0A;color:rgba(255,255,255,.85);padding:3rem 1.5rem 2rem"><div style="max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:2rem"><div><h4 style="color:#FFF;font-size:1rem;margin:0 0 .8rem">ANNECY</h4><p style="margin:0;font-size:.9rem;color:rgba(255,255,255,.7);line-height:1.6">Annecy, France</p></div><div><h4 style="color:#FFF;font-size:.92rem;margin:0 0 .8rem">SERVICES</h4><a href="etude-mecanique-sols/" style="color:rgba(255,255,255,.75);text-decoration:none;display:block;padding:.25rem 0">Services</a><a href="standard-penetration-test/" style="color:rgba(255,255,255,.75);text-decoration:none;display:block;padding:.25rem 0">SPT</a><a href="puits-dexploration/" style="color:rgba(255,255,255,.75);text-decoration:none;display:block;padding:.25rem 0">Test pits</a></div><div><h4 style="color:#FFF;font-size:.92rem;margin:0 0 .8rem">TALK TO US</h4><p style="margin:0;font-size:.9rem;line-height:1.8"><a href="mailto:contact@geotechnique.sbs" style="color:#FFF;text-decoration:none">contact@geotechnique.sbs</a></p></div></div><div style="max-width:1100px;margin:2rem auto 0;padding-top:1.2rem;border-top:1px solid rgba(255,255,255,.1);text-align:center;font-size:.8rem;color:rgba(255,255,255,.5)">© 2026 Geotechnique Fr. Tous droits réservés.</div><div data-updated="2026-05-15" style="font-size:.78rem;color:rgba(255,255,255,.6);margin-top:.8rem">Dernière mise à jour: 2026-05-15</div><div data-authority-refs class="authority-refs" style="text-align:center;font-size:.8rem;padding:.5rem 0;opacity:.6"><strong>Références:</strong>Normes AFNOR · Eurocode 7 · ISO Géotechnique</div></footer><script>(function(){document.querySelectorAll(".cat-toggle").forEach(function(b){b.addEventListener("click",function(e){e.preventDefault();var s=b.parentElement.parentElement.querySelector(".cat-sub-wrap");var ex=b.getAttribute("aria-expanded")==="true";b.setAttribute("aria-expanded",!ex);if(s){s.hidden=ex;}});});})();</script></body></html>